{
  "schema": 1,
  "telemetry": {
    "formats": ["json-v1", "compact-v2"],
    "compactBytes": 27
  },
  "sensors": [
    { "key": "temperature", "unit": "C" },
    { "key": "humidity", "unit": "%" },
    { "key": "atmosphere", "unit": "hPa" },
    { "key": "brightness", "unit": "lux" },
    { "key": "ph", "unit": "pH" },
    { "key": "tds", "unit": "ppm" },
    { "key": "soilMoisture", "unit": "%" }
  ],
  "actuators": [
    "WATER_PUMP",
    "UV_LIGHT",
    "FAN",
    "HUMIDIFIER",
    "NUTRIENT_DOSER",
    "PH_DOSER"
  ],
  "aliases": {
    "LIGHTS": "UV_LIGHT"
  },
  "commands": {
    "durationSeconds": { "min": 1, "max": 3600 },
    "invalidDurationMessage": "durationSeconds must be an integer between 1 and 3600",
    "validDurations": [1, 90, 3600],
    "invalidDurations": [-5, 0, 3601, 1.5, "30", true, []],
    "safety": {
      "criticalActuators": ["WATER_PUMP", "HUMIDIFIER"],
      "maxOnSeconds": 3600,
      "offlineCutoffSeconds": 300
    }
  }
}
