stateDiagram-v2
    [*] --> HardwareInit: Board Power-On / Boot

    state HardwareInit {
        [*] --> InitClocks: Initialize Xtensa CPU & Peripherals
        InitClocks --> InitNVS: Read Partition & Credentials
        InitNVS --> InitChannels: Allocate Static Lock-Free Channels
        InitChannels --> [*]
    }

    HardwareInit --> WiFiConnecting: Start Core 0 WiFi Task

    state WiFiConnecting {
        [*] --> ScanningAP: Scan SSIDs
        ScanningAP --> Associating: Connect with WPA2/WPA3
        Associating --> DHCPWait: Request IPv4 via DHCP
        DHCPWait --> WiFiConnected: Lease Acquired
        Associating --> ExponentialBackoff: Association / Auth Failed
        ExponentialBackoff --> Associating: Timer Expired (1s..30s)
    }

    WiFiConnecting --> SNTP_Sync: Network Route Ready

    state SNTP_Sync {
        [*] --> QueryNTP: Query pool.ntp.org (UDP 123)
        QueryNTP --> ClockSet: Set Unix Epoch Time
        QueryNTP --> RetryNTP: Timeout
        RetryNTP --> QueryNTP: Retry Backoff
        ClockSet --> [*]
    }

    SNTP_Sync --> TLS_Handshake: Time Synced (Cert Validation Valid)

    state TLS_Handshake {
        [*] --> LoadCA: Load Embedded Root CA & Client Certs
        LoadCA --> EstablishTCP: TCP Connect to Broker:8883
        EstablishTCP --> HandshakeTLS: Perform TLS 1.3 Handshake (mTLS / Server Cert)
        HandshakeTLS --> TLSEstablished: Cipher Suite Agreed
        HandshakeTLS --> TLSFailed: Verification Error / Timeout
        TLSFailed --> EstablishTCP: Reconnection Backoff
        TLSEstablished --> [*]
    }

    TLS_Handshake --> MQTT_Session: TLS Tunnel Active

    state MQTT_Session {
        [*] --> SendConnect: Send CONNECT with KeepAlive (60s) & LWT
        SendConnect --> AwaitConnAck: Wait for CONNACK
        AwaitConnAck --> SubscribeTopics: CONNACK 0x00 Success
        AwaitConnAck --> ConnectRejected: Bad Credentials / ACL Violation
        ConnectRejected --> [*]: Abort Session

        SubscribeTopics --> PublishCapabilities: Subscribe smartpot/v1/{cropId}/commands
        PublishCapabilities --> ActiveOperational: Publish Retained Capabilities (Schema 1)

        state ActiveOperational {
            [*] --> IdleMonitor
            IdleMonitor --> TransmitTelemetry: Every 30s or Event
            TransmitTelemetry --> IdleMonitor: Telemetry ACK Received

            IdleMonitor --> DispatchCommand: Inbound MQTT Message
            DispatchCommand --> ExecuteActuator: Validate Command Schema
            ExecuteActuator --> SendCommandAck: Actuator Started + Arm 300s Failsafe
            SendCommandAck --> IdleMonitor: Publish ACK to smartpot/v1/{cropId}/ack
        }
    }

    MQTT_Session --> WiFiConnecting: Network Loss / Broker Disconnect / LWT Fired
