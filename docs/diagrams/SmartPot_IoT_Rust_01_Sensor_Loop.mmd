flowchart TB
  subgraph acquisition["Physical Hardware Acquisition (Core 1)"]
    direction TB
    dht["DHT22 (GPIO15) / BME280 (I2C SDA 21 / SCL 22)<br/>Ambient Temperature & Relative Humidity"]
    analog["Analog ADC Sensors (16 samples per cycle)<br/>Soil Moisture (GPIO33) · TDS (GPIO32) · pH (GPIO35) · Light (GPIO34)"]
  end

  subgraph filtering["Digital Signal Processing Pipeline"]
    direction TB
    med["Median-5 Sliding Filter<br/>Erradiates electrical impulse noise"]
    kalman["Kalman Filter (Fixed-Point Q16.16)<br/>3-sigma gating & step-change tracking"]
    calib["Nernst Temperature Compensation<br/>Calibrates pH & TDS with live temperature"]
    med --> kalman --> calib
  end

  subgraph packaging["Telemetry Encoding & Output (Core 0)"]
    direction TB
    codec["Compact Binary v2 (27 Bytes)<br/>Magic 0x50 · CRC-8 · Field Presence Bitmask"]
    json["JSON v1 Fallback<br/>Standard JSON String payload"]
    display["LCD2004 SoftI2C Display<br/>Live telemetry metrics & connection status"]
  end

  dht & analog --> med
  calib --> codec & json & display
  codec & json --> mqtt["MQTT TLS 8883 Publisher"]

  classDef leaf fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef water fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef core fill:#067A52,stroke:#0B3D2B,color:#FFFFFF

  class dht,analog water
  class med,kalman,calib,codec,json,display leaf
  class mqtt core
