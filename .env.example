# SmartPot IoT firmware configuration (ESP32 / Rust).
# The usual way to configure the device is config.json (copy config.example.json):
# it uses the same blocks and keys as the MicroPython firmware and is read at
# build time. These variables override single values (CI, simulation); the
# firmware reads them at compile time through `option_env!`, so rebuild after
# changing them.

# Wi-Fi credentials.
SSID=Wokwi-GUEST
PASSWORD=

# Crop provisioning: 24-character crop id and the device key generated by the API.
CROP_ID=66f5a1000000000000000101
DEVICE_KEY=demo-lettuce-device-key-2026

# MQTT broker. Keep TLS enabled in production (port 8883).
# BROKER_HOST accepts a hostname or an IPv4 literal.
BROKER_HOST=mqtt.smartpot.app
BROKER_PORT=8883
# 1/true/yes enable TLS; 0/false/no disable it. Default: enabled.
USE_TLS=1

# PEM-encoded CA certificate that signed the broker certificate chain.
# Paste the full block including the BEGIN/END lines. Leave empty to fail closed
# when TLS is enabled (the firmware never falls back to an unverified link).
CA_CERT_PEM="-----BEGIN CERTIFICATE-----
REPLACE_WITH_YOUR_CA_CERTIFICATE_BASE64
-----END CERTIFICATE-----"

# SNTP server used to obtain the Unix epoch before the TLS handshake.
SNTP_SERVER=pool.ntp.org

# Define with any non-empty value to publish the 27-byte compact v2 telemetry
# packet instead of the JSON v1 payload.
COMPACT_TELEMETRY=1

# Optional tuning (defaults shown). The Wokwi simulation build shortens them.
# TELEMETRY_INTERVAL_SECS=15
# SENSOR_INTERVAL_SECS=10
# Seconds without a broker session before the water pump and humidifier stop.
# OFFLINE_CUTOFF_SECS=300
# WATCHDOG_TIMEOUT_SECS=30
# LIVENESS_TIMEOUT_SECS=120
# HEAP_LOG_SECS=60
# HEAP_MIN_FREE=

# Set to 1 for relay boards that switch on with a low input.
# ACTUATOR_ACTIVE_LOW=0

# Analog calibration: pH probe voltage at pH 7 and slope per pH unit at 25 °C
# (millivolts), and raw ADC readings of the soil sensor when dry and soaked.
# PH_NEUTRAL_MV=2500
# PH_SLOPE_MV=180
# SOIL_DRY_RAW=0
# SOIL_WET_RAW=4095
